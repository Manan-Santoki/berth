# Host people use for docker login/push/pull (shown in copy-paste commands).
REGISTRY_PUBLIC_HOST=localhost:5000

# Bootstrap admin: signs in to the dashboard and is the account Berth uses
# to talk to the registry. Also works for `docker login`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Shared secret the registry sends with activity webhooks.
# Generate with: openssl rand -hex 32
WEBHOOK_TOKEN=change-me-to-a-random-string

# Signs dashboard sessions. Leave empty to auto-generate (stored in Berth's volume).
SESSION_SECRET=

# Where registry layers are stored on the host. Any absolute path works,
# e.g. /mnt/storagebox/registry-data
REGISTRY_DATA_PATH=./data/registry
